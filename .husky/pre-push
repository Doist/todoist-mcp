sh .agents/scripts/branch-guard.sh push

# GUI git clients often run hooks without node on PATH. Skip the tests rather than block
# the push; CI runs them. npm is a node script, so check node itself too.
if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
    echo "pre-push: node not found, so the tests were skipped. CI still runs them." >&2
    exit 0
fi

npm test
